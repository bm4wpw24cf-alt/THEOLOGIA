# Kopier til .env.local for lokal utvikling (eller kjør `vercel env pull .env.local`).

# Postgres-tilkobling. Settes automatisk av Neon/Vercel Postgres-integrasjonen i Vercel.
DATABASE_URL=

# Tilfeldig streng brukt til å hashe IP-adresser for rate limiting (aldri lagres i klartekst).
# Generer f.eks. med: openssl rand -hex 32
COMMENT_IP_SALT=

# Beskytter /api/admin/* OG er passordet for innlogging på /admin.
# Generer f.eks. med: openssl rand -hex 32
ADMIN_TOKEN=
